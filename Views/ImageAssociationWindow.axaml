<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LabelAva.Models"
        xmlns:flua="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="LabelAva.Views.ImageAssociationWindow"
        Title="文件关联管理器"
        Width="720" Height="520"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel Margin="16">
        <!-- 顶部说明区 -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            
            <!-- 搜索文件夹行 -->
            <DockPanel>
                <TextBlock Text="项目路径" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
                <Button DockPanel.Dock="Right" Content="添加图片" Click="OnAddImage" Margin="4,0,0,0" Padding="12,8" FontSize="13" />
                <Button DockPanel.Dock="Right" Content="浏览" Click="OnBrowseFolder" Margin="4,0,0,0" Padding="12,8" FontSize="13"/>
                <TextBox x:Name="FolderPathBox" FontSize="13" TextChanged="OnFolderPathTextChanged"/>
            </DockPanel>
        </StackPanel>

        <!-- 自动匹配提示横幅 -->
        <Border x:Name="AutoMatchBanner"
                IsVisible="False"
                Opacity="0"
                Background="#E3F2FD"
                BorderBrush="#1976D2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,10"
                Margin="0,0,0,12"
                DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="AutoMatchBannerText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#1565C0"
                           TextWrapping="Wrap">
                    <TextBlock.Transitions>
                        <Transitions>
                            <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="ActionButton"
                            Content="填入"
                            Click="OnAutoFill"
                            FontSize="13" Padding="10,6"
                            Background="#1976D2" Foreground="White" />
                    <Button x:Name="ViewDetailsButton"
                            Content="详情"
                            Click="OnViewDetails"
                            IsVisible="False"
                            FontSize="13" Padding="10,6" />
                    <Button x:Name="DismissButton"
                            Content="忽略"
                            Click="OnDismissBanner"
                            FontSize="13" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部按钮区域 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" x:Name="StatusSummary" FontSize="13" Padding="12,8"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="ApplyOnlyButton" Content="应用但不保存" Click="OnApplyOnly" MinWidth="110" Padding="12,8" FontSize="13"/>
                <Button x:Name="SaveApplyButton" Content="保存并应用" Click="OnSaveApply" MinWidth="110" Padding="12,8" FontSize="13" Classes="primary"/>
                <Button Content="取消" Click="OnCancel" MinWidth="80" Padding="12,8" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- 主列表区 -->
        <Panel>
            <Border BorderBrush="{DynamicResource SystemControlForegroundChromeMediumBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="AssociationList" Margin="4" Background="Transparent" Focusable="False">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ImageAssociationItem">
                                <Border Margin="0,0,0,0" Background="Transparent"
                                        PointerPressed="OnItemPointerPressed"
                                        PointerMoved="OnItemPointerMoved"
                                        PointerReleased="OnItemPointerReleased">
                                    <Grid RowDefinitions="*,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,1*,1*,3*,Auto,Auto" VerticalAlignment="Center" Margin="6,8,6,8">
                                            <flua:FluentIcon Grid.Column="0" Icon="ReOrderDotsVertical" FontSize="14" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ImageName}" VerticalAlignment="Center" FontSize="13" FontFamily="Sarasa Mono SC" Margin="4,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" VerticalAlignment="Center" FontSize="13" Width="80" Margin="4,0,0,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding NewPath, Mode=TwoWay}" FontSize="13" VerticalContentAlignment="Center" PlaceholderText="(项目路径)"/>
                                            <Button Grid.Column="4" Content="浏览" Click="OnSelectFile" FontSize="13" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                                            <Button Grid.Column="5" Content="删除" Click="OnDeleteImage" FontSize="13" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Margin="0,0,4,0"
                                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Panel>
    </DockPanel>
</Window>
